# Copy this file to .env and fill in real values before running in production.

PORT=4000

# Secret used to sign JWTs. Generate a long random string for production —
# e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_IN=12h

# Shared secret placeholder for staff-only endpoints (PATCH /api/alerts/:id).
# This is a stand-in for real staff authentication (Chapter Five,
# recommendation: build the staff-facing dashboard with its own login).
STAFF_API_KEY=change-this-too
